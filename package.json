{
  "name": "taelgarverse-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "build:worker-headers": "node scripts/build-worker-headers.mjs",
    "cf:prepare": "node scripts/prepare-cloudflare.mjs",
    "cf:check": "node scripts/cloudflare.mjs check",
    "cf:seed": "node scripts/cloudflare.mjs upload-local",
    "cf:dev": "node scripts/cloudflare.mjs dev",
    "cf:bucket": "node scripts/cloudflare.mjs bucket",
    "cf:upload": "node scripts/cloudflare.mjs upload-remote",
    "cf:publish": "node scripts/cloudflare.mjs publish",
    "cf:deploy": "node scripts/cloudflare.mjs deploy",
    "cf:smoke": "node scripts/smoke-worker.mjs",
    "content:publish": "node scripts/publish-content.mjs",
    "pretest": "node scripts/build-runtime.mjs && node scripts/build-browser.mjs",
    "prestart": "node scripts/build-browser.mjs",
    "predev": "node scripts/build-browser.mjs",
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "markdown-it": "15.0.3",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "mermaid": "12.2.0",
    "wrangler": "4.151.1"
  }
}
