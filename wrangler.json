{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taelgarverse",
  "main": "src/worker.mjs",
  "build": {"command": "node scripts/build-core-release.mjs"},
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {"binding": "CONTENT", "bucket_name": "taelgarverse-content"}
  ],
  "d1_databases": [
    {"binding": "SEARCH_DB", "database_name": "taelgarverse-search", "database_id": "983f12bb-3952-4ff1-9224-a87f6d5c0b4f"}
  ],
  "observability": {"enabled": true}
}
