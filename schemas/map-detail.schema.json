{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regional artwork manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "image",
    "worldBounds",
    "pixelSize"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "image": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:[:?#\\\\]|\\.\\.))[^\\u0000-\\u001f]+\\.png$"
    },
    "worldBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    },
    "pixelSize": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384
      }
    },
    "fadeZoom": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -10,
        "maximum": 10
      },
      "default": [
        0,
        2
      ]
    }
  },
  "$comment": "Runtime also enforces <=64 million pixels, equal X/Y scale, world footprint <=100000 per axis, increasing fadeZoom, and exact decoded PNG dimensions."
}
