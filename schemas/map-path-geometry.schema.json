{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taelgar river/road path geometry",
  "type": "object",
  "required": [
    "version",
    "points"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Ordered original Photoshop [X,Y] pixels. Consecutive points must differ. No implicit closing segment."
    }
  }
}
